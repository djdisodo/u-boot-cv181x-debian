diff --git a/arch/riscv/dts/sg2002-nanokvm-pcie.dts b/arch/riscv/dts/sg2002-nanokvm-pcie.dts
new file mode 100644
index 0000000..e83dc2b
--- /dev/null
+++ b/arch/riscv/dts/sg2002-nanokvm-pcie.dts
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * SG2002 NanoKVM PCIe U-Boot DT
+ */
+
+/dts-v1/;
+
+#include "sg2002.dtsi"
+
+/ {
+	model = "Sipeed NanoKVM PCIe";
+	compatible = "sipeed,nanokvm-pcie", "sophgo,sg2002";
+
+	aliases {
+		gpio0 = &gpio0;
+		gpio1 = &gpio1;
+		gpio2 = &gpio2;
+		gpio3 = &gpio3;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&osc {
+	clock-frequency = <25000000>;
+};
+
+&sdhci0 {
+	status = "okay";
+	bus-width = <4>;
+	no-1-8-v;
+	no-mmc;
+	no-sdio;
+	disable-wp;
+};
+
+&uart0 {
+	status = "okay";
+};
